# 复制为 .env 并填写真实本地值；.env 不提交到 Git。
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_APP_PASSWORD=replace_with_local_app_password
MYSQL_PORT=3306
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/chayitong?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=chayitong
DB_PASSWORD=replace_with_local_app_password

WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
APP_MEDIA_STORAGE=local
APP_MEDIA_LOCAL_ROOT=./data/media
APP_MEDIA_PUBLIC_BASE_URL=http://localhost:8080/api/media
APP_COS_SECRET_ID=
APP_COS_SECRET_KEY=
APP_COS_REGION=ap-beijing
APP_COS_BUCKET=
APP_COS_PREFIX=picgo/
APP_SHOP_QUOTE_SECRET=replace_with_at_least_32_byte_random_secret
APP_SHOP_DEMO_PAYMENT_ENABLED=true
