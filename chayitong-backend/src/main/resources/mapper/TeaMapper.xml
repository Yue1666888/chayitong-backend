<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chayitong.chayitong_backend.TeaMapper">
  <resultMap id="teaResult" type="com.chayitong.chayitong_backend.TeaResponse">
    <constructor>
      <idArg column="id" javaType="java.lang.String" />
      <arg column="name" javaType="java.lang.String" />
      <arg column="type" javaType="java.lang.String" />
    </constructor>
  </resultMap>

  <sql id="teaFilters">
    <where>
      <if test="type != null">
        AND type = #{type}
      </if>
      <if test="namePattern != null">
        AND name LIKE #{namePattern} ESCAPE '!'
      </if>
    </where>
  </sql>

  <select id="countMatching" resultType="long">
    SELECT COUNT(*) FROM teas
    <include refid="teaFilters" />
  </select>

  <select id="findPage" resultMap="teaResult">
    SELECT id, name, type FROM teas
    <include refid="teaFilters" />
    ORDER BY id LIMIT #{limit} OFFSET #{offset}
  </select>
</mapper>
